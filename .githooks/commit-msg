#!/usr/bin/env bash
# commit-msg hook: enforce conventional commit subject, forbid plan and
# tracker numbers in the subject, forbid AI trailers.
# Installed by claude-ops/templates/install-githooks.sh via core.hooksPath.
set -euo pipefail

msg_file="$1"
subject="$(grep -v '^#' "$msg_file" | sed -n '1p')"

pattern='^(feat|fix|docs|refactor|chore|test|perf)(\([a-z0-9._-]+\))?: [a-z0-9].{2,71}$'

if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

if ! [[ "$subject" =~ $pattern ]]; then
  echo "commit-msg: subject does not match conventional format" >&2
  echo "  got:  $subject" >&2
  echo "  want: <type>(<scope>)?: <lowercase subject, 3-72 chars>" >&2
  echo "  types: feat fix docs refactor chore test perf" >&2
  exit 1
fi

# The subject becomes the PR title. Titles describe the change in words;
# step, track, phase, stage, issue, ticket and PR numbers belong in the
# tracker and the PR body. Version and count numbers (python 3.12, node 22)
# are not matched: only these words followed by a digit, or a bare #n.
label_pattern='(^|[^a-z])(step|steps|track|phase|stage|issue|issues|ticket|pr|prs)[[:space:]]?[0-9]'
hash_pattern='(^|[^a-z0-9])#[0-9]'

if [[ "$subject" =~ $label_pattern ]] || [[ "$subject" =~ $hash_pattern ]]; then
  echo "commit-msg: subject carries a plan or tracker number" >&2
  echo "  got:  $subject" >&2
  echo "  rejected: step/track/phase/stage/issue/ticket/pr followed by a digit, or #n" >&2
  echo "  describe the change in words; the tracker and the PR body carry the numbers" >&2
  exit 1
fi

if grep -qiE '^(Co-Authored-By|Generated-By|Signed-off-by: .*claude)' "$msg_file"; then
  echo "commit-msg: AI co-author or generator trailers are not allowed" >&2
  exit 1
fi
